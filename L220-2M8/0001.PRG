%
O0001 (Template Program)
( $1 - MAIN SPINDLE / GANG TOOL CHANNEL              )
( ================================================== )
$1
( --- PROGRAM INIT --- )
G28 H0                          ( REFERENCE RETURN ALL AXES )
G50 S10000                      ( MAX SPINDLE SPEED CLAMP )
G99                             ( FEED PER REVOLUTION MODE )
G40                             ( CANCEL CUTTER COMPENSATION )
M53                             ( COOLANT OFF - INIT STATE )

( ================================================== )
( OPERATION 1 - OD ROUGH TURNING                    )
( ================================================== )
( --- ROUGH TURN TOOL CALL --- )
T0101                           ( OD ROUGH TURN TOOL + OFFSET 01 )
G97 S#### M03                   ( SPINDLE ON CW - #### RPM )
M52                             ( COOLANT ON )
G00 X##.### Z1.0                ( RAPID TO CLEARANCE )
G01 Z-##.### F0.0###            ( ROUGH TURN TO LENGTH - ADJUST DEPTH/FEED )
G00 X##.### Z1.0                ( RETRACT )
( ADD ADDITIONAL ROUGHING PASSES AS NEEDED )

( ================================================== )
( OPERATION 2 - OD FINISH TURNING                   )
( ================================================== )
( --- FINISH TURN TOOL CALL --- )
T0202                           ( OD FINISH TURN TOOL + OFFSET 02 )
G96 S#### M03                   ( CONSTANT SURFACE SPEED - #### M/MIN )
G00 X##.### Z1.0                ( RAPID TO CLEARANCE )
G01 Z-##.### F0.0###            ( FINISH TURN TO LENGTH )
( ADD CHAMFERS / RADII / CONTOUR MOVES AS NEEDED )
( EXAMPLE CHAMFER: G01 X##.### Z-##.### F0.0### )
( EXAMPLE RADIUS:  G02 X##.### Z-##.### R##.### F0.0### )
G00 X##.### Z1.0                ( RETRACT )
G97                             ( RETURN TO CONSTANT RPM MODE )

( ================================================== )
( OPERATION 3 - GROOVING  [OPTIONAL - DELETE IF NOT NEEDED] )
( ================================================== )
( T0303                                              )
( G97 S#### M03                                      )
( G00 X##.### Z-##.###          RAPID TO GROOVE POSITION )
( G01 X##.### F0.0###           PLUNGE TO GROOVE DEPTH )
( G04 P###                      DWELL - ### MS )
( G01 X##.###                   RETRACT )
( G00 X##.### Z1.0              CLEAR )

( ================================================== )
( OPERATION 4 - THREADING  [OPTIONAL - DELETE IF NOT NEEDED] )
( ================================================== )
( T0404                                              )
( G97 S####  M03                                     )
( G00 X##.### Z2.0              APPROACH )
( G92 X##.### Z-##.### F#.###   THREAD CYCLE - F = LEAD IN MM )
( G92 X##.###                   NEXT PASS - DECREMENT X EACH PASS )
( G92 X##.###                                        )
( G92 X##.###                   FINAL PASS )
( G00 X##.### Z1.0              CLEAR )

( ================================================== )
( OPERATION 5 - SPOT DRILL / CENTER DRILL           )
( ================================================== )
( --- SPOT DRILL TOOL CALL --- )
T2121                           ( SPOT DRILL + OFFSET 21 )
G97 S#### M03                   ( SPINDLE ON CW - #### RPM )
G00 X0.0 Z5.0                   ( RAPID TO CENTERLINE CLEARANCE )
G01 Z-##.### F0.0###            ( SPOT DRILL TO DEPTH )
G00 Z5.0                        ( RETRACT )

( ================================================== )
( OPERATION 6 - DRILLING                            )
( ================================================== )
( --- DRILL 1 TOOL CALL --- )
T2222                           ( DRILL 1 + OFFSET 22 )
G97 S#### M03                   ( SPINDLE ON CW - #### RPM )
G00 X0.0 Z5.0                   ( RAPID TO CENTERLINE CLEARANCE )
( PECK DRILL CYCLE - G83 )
G83 Z-##.### R2.0 Q##.### F0.0###  ( PECK DRILL: Z=DEPTH R=RETRACT Q=PECK DEPTH )
G80                             ( CANCEL CANNED CYCLE )
G00 Z5.0                        ( RETRACT )

( --- DRILL 2 / REAMER / TAP [OPTIONAL] --- )
( T2323                                              )
( G97 S#### M03                                      )
( G00 X0.0 Z5.0                                      )
( G83 Z-##.### R2.0 Q##.### F0.0###  PECK DRILL )
( --- OR TAP: G84 Z-##.### R2.0 F#.### TAPPING CYCLE --- )
( G80                                                )
( G00 Z5.0                                           )

( ================================================== )
( CUTOFF SEQUENCE - SYNC WITH $2 PICK-OFF           )
( ================================================== )
( --- MOVE TO CUTOFF POSITION --- )
T0505                           ( CUTOFF TOOL + OFFSET 05 )
G97 S#### M03                   ( SPINDLE ON CW - #### RPM )
M52                             ( COOLANT ON )
G00 X##.### Z-##.###            ( RAPID TO CUTOFF Z POSITION )

( --- SYNC: WAIT FOR BACK SPINDLE TO BE IN POSITION --- )
G115 P1                         ( WAIT POINT 1 - BOTH CHANNELS MUST ARRIVE )

( --- SPINDLE SYNC FOR PICK-OFF --- )
M03                             ( ENSURE MAIN SPINDLE RUNNING )
G114.1 Q1                       ( SPINDLE PHASE SYNCHRONIZATION )
G115 P2                         ( WAIT POINT 2 - SYNC COMPLETE )

( --- CUTOFF PLUNGE --- )
G01 X-0.5 F0.0###               ( PLUNGE THROUGH - X-0.5 ENSURES FULL CUT )
M53                             ( COOLANT OFF )
G00 X##.###                     ( RETRACT )
G115 P3                         ( WAIT POINT 3 - CUTOFF COMPLETE )

( --- END OF $1 OPERATIONS --- )
M53                             ( COOLANT OFF )
M05                             ( MAIN SPINDLE STOP )
M56                             ( PART COUNT INCREMENT )
M99                             ( END $1 - LOOP BACK )

( ================================================== )
( $2 - BACK SPINDLE / COUNTER SPINDLE CHANNEL       )
( ================================================== )
$2

( --- BACK SPINDLE INIT --- )
G28 H0                          ( REFERENCE RETURN )
G99                             ( FEED PER REVOLUTION )
G40                             ( CANCEL CUTTER COMPENSATION )
M16                             ( OPEN BACK CHUCK )
M25                             ( BACK SPINDLE STOP - INIT STATE )

( ================================================== )
( PICK-OFF / PART TRANSFER SEQUENCE                 )
( ================================================== )
( --- MOVE TO PICK-OFF POSITION AND WAIT --- )
G00 Z##.###                     ( RAPID BACK SPINDLE TO PICK-OFF Z POSITION )
G115 P1                         ( WAIT POINT 1 - SYNC WITH $1 CUTOFF READY )

( --- SPINDLE SYNC AND CHUCK CLOSE --- )
G23 S#### M23                   ( BACK SPINDLE ON CW - MATCH MAIN SPINDLE RPM )
G114.1 Q1                       ( SPINDLE PHASE SYNCHRONIZATION )
G115 P2                         ( WAIT POINT 2 - SYNC COMPLETE )
M15                             ( CLOSE BACK CHUCK )
M123                            ( BACK SPINDLE TORQUE LIMIT ON - ANTI-SLIP )
G115 P3                         ( WAIT POINT 3 - WAIT FOR CUTOFF COMPLETE )
M124                            ( BACK SPINDLE TORQUE LIMIT OFF )

( ================================================== )
( OPERATION 7 - BACK SPINDLE OD TURNING [OPTIONAL] )
( ================================================== )
( --- BACK TURN TOOL CALL --- )
T3131                           ( BACK TURN TOOL + OFFSET 31 )
G97 S#### M23                   ( BACK SPINDLE ON CW - #### RPM )
M52                             ( COOLANT ON )
G00 X##.### Z##.###             ( RAPID TO CLEARANCE )
G01 Z##.### F0.0###             ( BACK TURN TO LENGTH )
G00 X##.### Z##.###             ( RETRACT )

( ================================================== )
( OPERATION 8 - BACK SPINDLE DRILLING [OPTIONAL]   )
( ================================================== )
( --- BACK DRILL TOOL CALL --- )
T3232                           ( BACK DRILL + OFFSET 32 )
G97 S#### M23                   ( BACK SPINDLE ON CW - #### RPM )
G00 X0.0 Z##.###                ( RAPID TO CENTERLINE CLEARANCE )
G83 Z##.### R##.### Q##.### F0.0###  ( PECK DRILL - NOTE: Z POSITIVE FROM BACK )
G80                             ( CANCEL CANNED CYCLE )
G00 Z##.###                     ( RETRACT )

( --- BACK DRILL 2 / TAP [OPTIONAL] --- )
( T3333                                              )
( G97 S#### M23                                      )
( G00 X0.0 Z##.###                                   )
( G83 Z##.### R##.### Q##.### F0.0###  PECK DRILL )
( --- OR TAP: G84 Z##.### R##.### F#.### TAPPING CYCLE --- )
( G80                                                )
( G00 Z##.###                                        )

( --- END OF $2 OPERATIONS --- )
M53                             ( COOLANT OFF )
M16                             ( OPEN BACK CHUCK )
M25                             ( BACK SPINDLE STOP )
M99                             ( END $2 - LOOP BACK )

